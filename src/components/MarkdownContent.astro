---
// Wraps Starlight's Markdown content: adds a translation/source banner above lessons
// and the "check your understanding" section (quiz + hands-on) below them.
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { getEntry } from 'astro:content';
import LessonAssessment from './LessonAssessment.astro';
import { ui, type Lang } from '../data/ui';

const route = Astro.locals.starlightRoute;
const lang: Lang = route.lang?.startsWith('th') ? 'th' : 'en';
const t = ui[lang];
const lessonKey = route.entry.id.replace(/^(en|th)\//, '');
const isLesson = /^\d\d-[^/]+\/\d\d-[^/]+$/.test(lessonKey);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

let banner: { kind: 'current' | 'stale' | 'source'; other?: string; source?: string } | null = null;
if (isLesson) {
  const en = await getEntry('docs', `en/${lessonKey}`);
  const th = await getEntry('docs', `th/${lessonKey}`);
  const source = en?.data.upstream_path ? `https://github.com/rohitg00/ai-engineering-from-scratch/tree/${en.data.upstream_commit ?? 'main'}/${en.data.upstream_path}` : undefined;
  if (lang === 'th' && !route.isFallback && th) {
    banner = { kind: th.data.source_hash === en?.data.source_hash ? 'current' : 'stale', other: `${base}en/${lessonKey}/`, source };
  } else if (lang === 'en') {
    banner = { kind: 'source', other: th ? `${base}th/${lessonKey}/` : undefined, source };
  }
}
---

<Default>
  {
    banner && (
      <div class:list={['ail-banner', 'not-content', { stale: banner.kind === 'stale' }]}>
        <span>
          <strong>{t.bannerTranslated}</strong> · {banner.kind === 'stale' ? t.bannerStale : t.bannerCurrent}
        </span>
        {banner.other && <a href={banner.other}>{t.bannerViewEn}</a>}
        {banner.source && <a href={banner.source}>{t.bannerSource}</a>}
      </div>
    )
  }
  <slot />
  {isLesson && <LessonAssessment lessonKey={lessonKey} lang={lang} />}
</Default>

{
  isLesson && (
    <>
      <script is:inline id="ail-ui" type="application/json" set:html={JSON.stringify(t)} />
      <script is:inline src={`${base}vendor/figures/lesson-figures.js`} />
      <script>
        import '../scripts/lesson-page.ts';
      </script>
    </>
  )
}
